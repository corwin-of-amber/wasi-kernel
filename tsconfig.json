{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "lib": ["esnext", "dom"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "exclude": ["src/extra"]
}