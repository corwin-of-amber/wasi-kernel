{
    "wasix": true,
    "*": {
        "native": false
    },
    "hello": {
        "native": false,
        "output": "hello.wasm",
        "args": ["-Wl,--allow-undefined"]
    },
    "files": {
        "asyncify": false,
        "output": "files.wasm"
    },
    "subproc": {
        "output": "subproc.wasm"
    },
    "subproc-pipe": {
        "output": "subproc-pipe.wasm"
    },
    "jump": {
        "output": "jump.wasm"
    },
    "threads": {
        "output": "threads.wasm",
        "args": ["--target=wasm32-wasi", "-Wl,--allow-undefined"],
        "_comment": ["for wasmer: add `-fPIC -Wl,-pie` and use wasix exnref-ehpic"]
    },
    "spawn": {
        "output": "spawn.wasm"
    },
    "stdin": {
        "output": "stdin.wasm"
    },
    "dl-simple": {
        "args": ["-fwasm-exceptions", "--target=wasm32-wasi",
                 "-Wl,--allow-multiple-definition", "-Wl,--allow-undefined",
                 "-Wl,--export=simple_func", "-Wl,--export=simple_array", "-fPIC", "-Wl,--import-table"],
        "output": "dl-simple.wasm",
        "_comment": ["for wasmer: replace `-Wl,--import-table` with `-Wl,-pie` and use wasix exnref-ehpic"]
    },
    "io-fstream": {
        "wasix": false,
        "output": "io-fstream.wasm"
    },
    "exceptions": {
        "wasix": false,
        "output": "exceptions.wasm",
        "args": ["-fwasm-exceptions",
            "-Wl,--export=__cpp_exception", "-Wl,--export-table",
            "-mllvm=-wasm-use-legacy-eh=false", "-lunwind",
            "-Wl,--allow-undefined"],
        "minSdk": 33
    },
    "exceptions+threads": {
        "wasix": true,
        "output": "exceptions.wasm",
        "args": ["-fwasm-exceptions", "--target=wasm32-wasi",
            "-Wl,--export=__cpp_exception", "-Wl,--export-table",
            "-mllvm=-wasm-use-legacy-eh=false",
            "-Wl,--allow-undefined"],
        "minSdk": 33
    }
}
